APP_NAME="Architecture Portfolio API"
APP_ENV=development
DEBUG=false
# JSON array of exact frontend origins (no trailing slash).
CORS_ORIGINS=["http://localhost:4200"]
# Replace placeholders locally; percent-encode special characters in credentials.
DATABASE_URL=postgresql+psycopg://portfolio:CHANGE_ME@localhost:5432/portfolio
# Generate a random value locally; the application rejects this placeholder.
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# R2 sends file bytes directly to R2; local PUT remains bounded by this backend cap.
MAX_REQUEST_BODY_BYTES=1048576
# Per ASGI peer and worker, fixed 60-second windows; configure trusted proxies.
AUTH_REQUESTS_PER_MINUTE=30
CONTACT_REQUESTS_PER_MINUTE=10
# local needs no external credentials. Use r2 after creating a PRIVATE R2 bucket.
STORAGE_PROVIDER=local
MEDIA_BASE_URL=http://127.0.0.1:8000
LOCAL_STORAGE_PATH=.media
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Reserved; public bucket/CDN exposure is not enabled by this integration.
R2_PUBLIC_BASE_URL=
R2_PRESIGNED_URL_EXPIRE_SECONDS=300
# Must exceed your maximum in-flight upload duration and clock/network skew.
MEDIA_CLEANUP_GRACE_SECONDS=3600
# Defaults are operating budgets, not format/specification limits (bytes).
MEDIA_MAX_FILE_SIZE_BYTES=536870912
MEDIA_IMAGE_MAX_BYTES=20971520
MEDIA_PDF_MAX_BYTES=52428800
MEDIA_MODEL_MAX_BYTES=104857600
MEDIA_VIDEO_MAX_BYTES=536870912
